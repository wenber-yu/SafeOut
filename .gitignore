# ---- 构建产物 ----
Dist/
.build/
/Packages
SPMPackages/

# 覆盖率运行会把 profraw 落到「当前工作目录」（不是 .build/ 里）——
# `swift test --enable-code-coverage` 之后直接跑一次二进制就会在仓库根留下它。
default.profraw

# `Tools/clt_swift_env.sh` 在「Xcode 许可未接受」时会往**包根**放一个指向 Xcode
# `xcstringstool` 的软链：CLT 没有这个工具，而 SwiftPM 找不到它时按**包根**回落
# （不是调用目录，也不看 PATH —— 见该脚本注释）。只锚定包根，不匹配子目录同名文件。
/xcstringstool

# ---- Xcode / SPM 本地状态 ----
xcuserdata/
DerivedData/
.swiftpm/
# ⚠️ 2026-09-24 删掉两条**冗余**：`.swiftpm/configuration/registries.json` 与
#    `.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata` ——
#    上面那句 `.swiftpm/` 已经覆盖它们（gitignore 里非 `!` 开头的规则只做忽略，
#    不会重新纳入）。那两条是从 GitHub 的 Swift.gitignore 模板照抄来的，模板里
#    本来是配合别的条目用的，到这儿就成了死条目。
.netrc

# ---- 设计工具运行时产物 ----
# solo-design 生成的调度清单与会话摘要，内含本机绝对路径（/Users/...），
# 属工具元数据而非设计交付物；设计本身见 ui/pages/*.html 与 ui/colors_and_type.css。
#
# ⚠️ 这条锚的是**迁移后**的路径（2026-09-24：SafeOut-UI-Design/ → Design/ui/）。
#    目录一搬，旧规则会**静默失效** —— 不报错、也没有任何东西会红，
#    只是那两个 runtime-*.json 突然出现在 `git status` 里（实测已复现）。
Design/ui/runtime-*.json

# ---- 真机实验装置产物 ----
# `feedsrv.py` 的请求日志默认就落在**脚本所在目录**（Tools/probe/）里，且默认路径
# 不能改（有人照旧用法去那儿找日志）；`make_broken_appcast.py` 生成的那一份也常被
# 拷到 Tools/probe/appcast.xml，因为 feedsrv.py 只服务它自己那个目录、挪不走。
# ⇒ 这两类是每次真机实验后必然出现的脏文件，直接忽略（只锚 Tools/probe/ 下，
#   不碰仓库根那份真 appcast.xml）。
Tools/probe/feed-hits.log
Tools/probe/appcast.xml

# ---- macOS ----
.DS_Store

# ---- 本地工作记忆（本项目会话日志与长期笔记，不入库）----
.workbuddy/
# 新一代记忆目录（与 .workbuddy/ 并存，同样不入库）
.workbuddy-ai/

# ---- Python（Tools/ 下的探针脚本跑一次就会生成）----
__pycache__/
*.pyc
