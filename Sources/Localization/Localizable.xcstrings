      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "推出" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Eject" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "退出" } }
      }
    },
    "ejectAttentionTitle" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "「%@」被占用，无法推出" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "\u201c%@\u201d is in use and can\u2019t be ejected" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "「%@」被佔用，無法退出" } }
      }
    },
    "notifEjectBlockedBody" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 正在使用这块磁盘。点按这条通知，可在%@里关闭它并推出。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ is using this disk. Click this notification to close it and eject from %@." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@ 正在使用這顆磁碟。點一下這則通知，可在%@裡關閉它並退出。" } }
      }
    },
    "notifEjectResultFailureTitle" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "「%@」推出失败" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn\u2019t eject \u201c%@\u201d" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "「%@」退出失敗" } }
      }
    },
    "notifEjectResultSuccessBody" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "磁盘已推出，现在可以安全拔下了。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The disk was ejected. You can safely unplug it now." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "磁碟已退出，現在可以安全拔下了。" } }
      }
    },
    "notifEjectResultSuccessTitle" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "「%@」已安全推出" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "\u201c%@\u201d ejected safely" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "「%@」已安全退出" } }
      }
    },
    "ejectFailedInUseReason" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "磁盘仍然被占用。有一个程序在这块盘上打开了文件，请关闭它后重试。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The disk is still in use. An app has files open on it — quit that app and try again." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "磁碟仍被佔用中。有程式在這顆磁碟上開啟了檔案，請關閉它後再試一次。" } }
      }
    },
    "ejectDiskFormat" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "推出 %@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Eject %@" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "退出 %@" } }
      }
    },
    "ejectingDiskFormat" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在推出 %@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ejecting %@" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在退出 %@" } }
      }
    },
    "followSystemLanguage" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跟随系统" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Follow System" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "跟隨系統" } }
      }
    },
    "languageFollowSystemHintFormat" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跟随系统语言（当前：%@）" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Follows the system language (currently: %@)" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "跟隨系統語言（目前：%@）" } }
      }
    },
    "languageInEffectHintFormat" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前：%@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Currently: %@" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前：%@" } }
      }
    },
    "languagePendingHintFormat" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将在重启后切换为 %@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Will switch to %@ after restart" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將在重新啟動後切換為 %@" } }
      }
    },
    "openMainWindow" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开主窗口" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Main Window" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "打開主視窗" } }
      }
    },
    "ejectFailedNotFoundReason" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "磁盘「%@」已不在，可能已被拔除或已卸载。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The disk \"%@\" is no longer available; it may have been unplugged." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "磁碟「%@」已不存在，可能已被拔除或已卸載。" } }
      }
    },
    "ejectFailedNotPermittedReason" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统不允许推出磁盘「%@」。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The system does not allow ejecting the disk \"%@\"." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "系統不允許退出磁碟「%@」。" } }
      }
    },
    "ejectFailedOtherReason" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法推出磁盘「%@」：%@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Failed to eject the disk \"%@\": %@" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法退出磁碟「%@」：%@" } }
      }
    },
    "ejectFailedTitleFormat" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法推出「%@」" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Can't Eject \"%@\"" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法退出「%@」" } }
      }
    },
    "ejectFailedCausesTitle" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可能的原因" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Possible causes" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可能的原因" } }
      }
    },
    "ejectFailedCauseFileOpen" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "有程序仍在这块盘上打开了文件（常见于播放器、编辑器、备份工具）" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "An app still has files open on this disk (often players, editors, backup tools)" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "有程式仍在這顆磁碟上開啟檔案（常見於播放器、編輯器、備份工具）" } }
      }
    },
    "ejectFailedCauseSpotlight" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Spotlight 正在为这块盘建立索引，稍等片刻后重试" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Spotlight is still indexing this disk — wait a moment and try again" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Spotlight 正在為這顆磁碟建立索引，稍候片刻再試一次" } }
      }
    },
    "ejectFailedCauseNotRemovable" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这块卷不是可推出的设备（例如内置磁盘、网络宗卷）" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This volume is not an ejectable device (for example a built-in disk or a network volume)" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這個卷宗不是可退出的裝置（例如內建磁碟、網路卷宗）" } }
      }
    },
    "ejectFailedCauseSystemHold" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统正在持有这块卷（例如系统镜像，或由管理策略挂载的宗卷）" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The system is holding this volume (for example a system image, or a managed volume)" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "系統正在持有這個卷宗（例如系統映像，或由管理政策掛載的卷宗）" } }
      }
    },
    "ejectBusyTitle" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "即将推出「%@」" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "About to Eject \"%@\"" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "即將退出「%@」" } }
      }
    },
    "ejectBusyMessageFormat" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "以下程序正在读写这块磁盘。它们挡着推出的路，需要先结束才能推出。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The following apps are reading from or writing to this disk. They are blocking the eject and must be quit first." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "以下程式正在讀寫這顆磁碟。它們擋住了退出，必須先結束才能退出。" } }
      }
    },
    "ejectBusyOccupiedHeaderFormat" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在占用 · %d 个" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%d using it" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在佔用 · %d 個" } }
      }
    },
    "ejectBusyIrreversibleCaption" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此操作不可撤销" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This can't be undone" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此操作無法復原" } }
      }
    },
    "processPidFormat" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "PID %d" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "PID %d" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "PID %d" } }
      }
    },
    "ejectBusyNoProcessInfo" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "磁盘「%@」正被占用，但当前无法列出具体程序。请确认已在「系统设置 › 隐私与安全性 › 完全磁盘访问」中允许磁盘推出助手后重试。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The disk \"%@\" is in use, but the specific apps cannot be listed. Make sure SafeOut is granted Full Disk Access in System Settings › Privacy & Security, then try again." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "磁碟「%@」正被佔用，但目前無法列出具體程式。請確認已在「系統設定 › 隱私與安全性 › 完全磁碟存取」中允許磁碟推出助手後再試。" } }
      }
    },
    "ejectBusyWarning" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭它们会丢失未保存的内容。%@会先请求正常退出，几秒后仍未退出的将被强制结束，然后重新尝试推出。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Quitting them loses any unsaved work. %@ first asks them to quit, force-quits any that are still running a few seconds later, then tries to eject again." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉它們會遺失未儲存的內容。%@ 會先請求正常結束，幾秒後仍未結束的將被強制結束，然後重新嘗試退出。" } }
      }
    },
    "closeAndEject" : {
