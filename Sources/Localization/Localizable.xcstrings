    "updateCallout" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点「后台更新并重启」后，应用会在后台下载并校验签名，装好后自动重启。正在推出的磁盘不会被打断。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "After you choose \"Update in Background & Restart\", the app downloads and verifies the update in the background, then restarts to install. Disks being ejected aren't interrupted." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "按下「背景下載並重新啟動」後，應用程式會在背景下載並驗證簽章，裝好後自動重新啟動。正在退出的磁碟不會被中斷。" } }
