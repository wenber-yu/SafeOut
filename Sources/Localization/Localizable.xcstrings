{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "accentColor" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "强调色" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Accent Color" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "強調色" } }
      }
    },
    "accessibilityOnboardingMessage" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已开启推出提醒。磁盘推出后，系统留下的「占用中」提示框会自动关掉。如果在系统设置里允许 %@ 使用辅助功能，会关得更准：只关这块盘的提示框，不动其它盘。不授权也能用。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Eject alerts are on. After a disk is ejected, the system's leftover \"in use\" alert closes by itself. If you allow %@ to use Accessibility in System Settings, it closes more precisely — only that disk's alert, never another one. It works without it." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已開啟推出提醒。磁碟退出後，系統留下的「佔用中」提示框會自動關掉。如果在系統設定裡允許 %@ 使用輔助功能，會關得更準：只關這顆磁碟的提示框，不動其它磁碟。不授權也能用。" } }
      }
    },
    "accessibilityOnboardingTitle" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可选：允许辅助功能" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Optional: Allow Accessibility" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可選：允許輔助功能" } }
      }
    },
    "appLanguage" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语言" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Language" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "語言" } }
      }
    },
    "appName" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "磁盘推出助手" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "SafeOut" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "磁碟推出助手" } }
      }
    },
    "autoCheckUpdate" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动检查更新" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Check for Updates Automatically" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自動檢查更新" } }
      }
    },
    "autoCheckUpdateHint" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启动时和后台定期检查新版本。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Checks at launch and in the background." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟動時和背景定期檢查新版本。" } }
      }
    },
    "autoDownloadNeedsCheckHint" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需先打开上面的「自动检查更新」。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn on “Check for Updates Automatically” first." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需先開啟上面的「自動檢查更新」。" } }
      }
    },
    "autoDownloadUpdate" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动下载更新" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Download Updates Automatically" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自動下載更新" } }
      }
    },
    "autoDownloadUpdateHint" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发现新版本后自动下载，退出时安装。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloads in the background and installs on quit." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "發現新版本後自動下載，結束時安裝。" } }
      }
    },
    "autoUpdateUnavailableHint" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动更新没起来；可以手动检查。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto-update didn't start; check manually." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自動更新沒起來；可以手動檢查。" } }
      }
    },
    "cancel" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消" } },
