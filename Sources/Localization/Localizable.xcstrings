      }
    },
    "fdaOnboardingStep3Note" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无需重启，占用情况会自动刷新" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No restart needed — usage info refreshes automatically" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無需重新啟動，佔用情況會自動重新整理" } }
      }
    },
    "fdaOnboardingPrivacy" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这项权限只用于读取「哪个进程打开了磁盘上的文件」，%@ 不会读取你的文件内容。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This permission is only used to read which process has a file open on the disk. %@ never reads your file contents." } },
