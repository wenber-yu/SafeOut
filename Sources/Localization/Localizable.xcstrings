    "noRemovableDisks" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有外置磁盘" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No External Disks" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "沒有外接磁碟" } }
      }
    },
    "fdaOnboardingTitle" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要「完全磁盘访问」" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Full Disk Access” Required" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需要「完全磁碟存取」" } }
      }
    },
    "fdaOnboardingBody" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要知道**是哪个程序占着你的硬盘**，%@ 需要这项系统权限。\nmacOS 不允许普通应用查看其他进程打开的文件——不给权限，就只剩一个空列表。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "To see **which app is using your drive**, %@ needs this system permission.\nmacOS doesn’t let ordinary apps see files opened by other processes — without it, you’re left with an empty list." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "要知道**是哪個程式佔著你的硬碟**，%@ 需要這項系統權限。\nmacOS 不允許一般應用程式查看其他行程開啟的檔案——不給權限，就只剩一個空清單。" } }
      }
    },
    "fdaOnboardingStep1Text" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点下面的按钮，直接打开设置" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Click the button below to open the right pane" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "點下面的按鈕，直接開啟設定" } }
      }
    },
    "fdaOnboardingPathSettings" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统设置 › 隐私与安全性 › 完全磁盘访问" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "System Settings › Privacy & Security › Full Disk Access" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "系統設定 › 隱私權與安全性 › 完全磁碟存取" } }
      }
    },
    "fdaOnboardingStep2Text" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在列表里找到 %@，打开它右边的开关" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Find %@ in the list and turn on its switch" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在列表裡找到 %@，開啟它右邊的開關" } }
      }
    },
    "fdaOnboardingStep2Note" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "若不在列表中，点左下角 %@ 从「应用程序」添加" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "If it’s not listed, click %@ at the bottom left to add it from Applications" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "若不在列表中，點左下角 %@ 從「應用程式」加入" } }
      }
    },
    "fdaOnboardingPathAdd" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "＋" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "+" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "＋" } }
      }
    },
    "fdaOnboardingStep3Text" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "切回 %@ 即可" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Switch back to %@" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "切回 %@ 即可" } }
      }
    },
    "fdaOnboardingStep3Note" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无需重启，占用情况会自动刷新" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No restart needed — usage info refreshes automatically" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無需重新啟動，佔用情況會自動重新整理" } }
      }
    },
    "fdaOnboardingPrivacy" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这项权限只用来知道「哪个程序打开了这个盘上的文件」，%@ 不会读你的文件内容。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This permission only tells us which app has a file open on the disk. %@ never reads your files." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這項權限只用來知道「哪個程式開啟了這個磁碟上的檔案」，%@ 不會讀你的檔案內容。" } }
