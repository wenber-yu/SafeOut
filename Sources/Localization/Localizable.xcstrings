    },
    "launchAtLoginNeedsApprovalMessage" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 要求手动允许登录项。请前往「系统设置 → 通用 → 登录项」，开启磁盘推出助手的开关。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS requires manual approval for login items. Go to System Settings \u2192 General \u2192 Login Items and enable SafeOut." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "macOS 要求手動允許登入項目。請前往「系統設定 \u2192 一般 \u2192 登入項目」，開啟磁碟推出助手的開關。" } }
      }
    },
    "launchAtLoginUnavailableMessage" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前无法设置登录项。请将磁盘推出助手移到「应用程序」文件夹后重试。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Login items are unavailable. Move SafeOut to the Applications folder and try again." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前無法設定登入項目。請將磁碟推出助手移到「應用程式」檔案夾後再試一次。" } }
      }
