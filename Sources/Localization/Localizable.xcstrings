    "launchAtLoginFootnote" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开机后驻留菜单栏，插上盘就能用。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Lives in the menu bar after login, ready when you plug in a disk." } },
